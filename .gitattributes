# Normalize text to LF in the repo and in every working copy (Windows dev, Ubuntu CI).
* text=auto eol=lf

# Binary formats: never touch line endings, never diff/merge as text.
*.docx binary
*.xlsx binary
*.zip binary
*.parquet binary
*.png binary
*.gz binary

# D-359: the parity reference fixtures are byte-identical copies of the raw store and their
# sha256 is asserted against it. Never normalize them, or the hashes stop matching.
tests/fixtures/parity/** binary
