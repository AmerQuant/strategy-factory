//@version=6
strategy("SF parity MR - RSI2 daily", overlay = true,
     initial_capital = 100000, default_qty_type = strategy.cash, default_qty_value = 100000,
     pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.02,
     slippage = 0, process_orders_on_close = false, calc_on_every_tick = false,
     calc_on_order_fills = false, use_bar_magnifier = false, fill_orders_on_standard_ohlc = true,
     margin_long = 0, margin_short = 0)

rsiLen  = input.int(2, "RSI length")
rsiThr  = input.float(10.0, "RSI threshold")
maxBars = input.int(5, "Max bars in trade")
atrLen  = input.int(14, "ATR length")
stopAtr = input.float(3.0, "Disaster stop (ATR)")

r = ta.rsi(close, rsiLen)
a = ta.atr(atrLen)

flat    = strategy.position_size == 0
longSig = flat and not na(r) and not na(a) and r < rsiThr

if longSig
    strategy.entry("L", strategy.long)
    // stop distance fixed at the signal bar; TradingView measures it from the actual fill price
    strategy.exit("L-SL", "L", loss = math.round(stopAtr * a / syminfo.mintick), comment_loss = "SL")

if strategy.position_size > 0
    barsHeld = bar_index - strategy.opentrades.entry_bar_index(0) + 1
    if close > high[1]
        strategy.close("L", comment = "PrevHigh")
    else if barsHeld >= maxBars
        strategy.close("L", comment = "Time")