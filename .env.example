# Copy to `.env` and adjust. `.env` is git-ignored; process environment variables win.

# Canonical parquet snapshot store (outside the repo), e.g. <...>/StrategyFactory_data/store
SFAC_DATA_ROOT=
# Immutable raw copies + downloads (outside the repo), e.g. <...>/StrategyFactory_data/raw
SFAC_RAW_ROOT=
# Read-only source folder of the TradeStation 1H futures exports (inventory only).
SFAC_SRC_ATM_FUTURES=
# Run artifacts (reports, evidence packages, logs).
SFAC_ARTIFACTS_ROOT=D:/SfacData/artifacts

# Registry database (docker-compose.yml reads the three values below).
SFAC_DB_USER=sfac
SFAC_DB_PASSWORD=sfac
SFAC_DB_NAME=sfac
SFAC_DB_PORT=5432
SFAC_DB_URL=postgresql+psycopg://sfac:sfac@localhost:5432/sfac

# Alpaca market data (T04a). Values only in the local .env; never commit them.
ALPACA_API_KEY=
ALPACA_API_SECRET=
