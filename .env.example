# Copy to `.env` and adjust. `.env` is git-ignored; process environment variables win.

# Immutable parquet snapshot store (outside the repo; never a raw source-data folder).
SFAC_DATA_ROOT=D:/SfacData/store
# Run artifacts (reports, evidence packages, logs).
SFAC_ARTIFACTS_ROOT=D:/SfacData/artifacts

# Registry database (docker-compose.yml reads the three values below).
SFAC_DB_USER=sfac
SFAC_DB_PASSWORD=sfac
SFAC_DB_NAME=sfac
SFAC_DB_PORT=5432
SFAC_DB_URL=postgresql+psycopg://sfac:sfac@localhost:5432/sfac
